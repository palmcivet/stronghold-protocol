{
  "name": "stronghold-deployment",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./static-policy": {
      "@wsde/source": "./client/config/static-policy.ts",
      "types": "./client/dist/config/static-policy.d.ts",
      "import": "./client/dist/config/static-policy.js",
      "default": "./client/dist/config/static-policy.js"
    }
  },
  "imports": {
    "#static-policy.js": {
      "@wsde/source": "./client/config/static-policy.ts",
      "default": "./client/dist/config/static-policy.js"
    }
  },
  "scripts": {
    "build": "tsc -b client",
    "check": "pnpm check:src && pnpm check:test",
    "check:src": "tsc -p client --noEmit --incremental false --composite false",
    "check:test": "tsc -p client/tsconfig.test.json",
    "clean": "rimraf client/dist client/dist-test client/tsconfig.test.tsbuildinfo",
    "format": "biome check --write",
    "lint": "biome lint",
    "test": "vitest run --root client"
  },
  "dependencies": {
    "@alliance/data": "workspace:*"
  },
  "devDependencies": {
    "@wsde/shared": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zx": "^8.8.5"
  }
}
