{
  "name": "arknights-compat-upstream",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#data/*.js": {
      "source": "./data/*.ts",
      "default": "./dist/data/*.js"
    },
    "#case-map/*.js": {
      "source": "./case-map/*.ts",
      "default": "./dist/case-map/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "case-map": "node dist/case-map/cli.js"
  },
  "dependencies": {
    "arknights-assets-catalog": "workspace:*",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
