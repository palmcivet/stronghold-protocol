{
  "name": "@alliance/data",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./workspace": {
      "source": "./workspace.ts",
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "default": "./dist/workspace.js"
    },
    "./gamedata": {
      "source": "./compiler/gamedata.ts",
      "types": "./dist/compiler/gamedata.d.ts",
      "import": "./dist/compiler/gamedata.js",
      "default": "./dist/compiler/gamedata.js"
    },
    "./refs": {
      "source": "./schema/pack-refs.ts",
      "types": "./dist/schema/pack-refs.d.ts",
      "import": "./dist/schema/pack-refs.js",
      "default": "./dist/schema/pack-refs.js"
    },
    "./pack-layout": {
      "source": "./schema/pack-layout.ts",
      "types": "./dist/schema/pack-layout.d.ts",
      "import": "./dist/schema/pack-layout.js",
      "default": "./dist/schema/pack-layout.js"
    }
  },
  "imports": {
    "#workspace.js": {
      "source": "./workspace.ts",
      "default": "./dist/workspace.js"
    },
    "#compiler/*.js": {
      "source": "./compiler/*.ts",
      "default": "./dist/compiler/*.js"
    },
    "#runtime/*.js": {
      "source": "./runtime/*.ts",
      "default": "./dist/runtime/*.js"
    },
    "#schema/*.js": {
      "source": "./schema/*.ts",
      "default": "./dist/schema/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "pnpm check:src && pnpm check:test",
    "check:src": "tsc --noEmit --incremental false --composite false",
    "check:test": "tsc -p tsconfig.test.json",
    "clean": "rimraf dist dist-test tsconfig.test.tsbuildinfo",
    "compile:derive": "node dist/compiler/scripts/derive.js",
    "compile:emotes": "node dist/compiler/scripts/emotes.js",
    "compile:needs": "node dist/compiler/scripts/needs.js",
    "compile:packet": "node dist/compiler/scripts/packet.js",
    "compile:packs": "node dist/compiler/scripts/packs.js",
    "extract:media": "node dist/compiler/scripts/extract.js",
    "format": "biome check --write",
    "lint": "biome lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@alliance/shared": "workspace:*",
    "arknights-assets-catalog": "workspace:*",
    "arknights-assets-extractor": "workspace:*",
    "arknights-mission-core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
