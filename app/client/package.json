{
  "name": "@alliance/client",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "build:web": "vite build",
    "check": "pnpm check:src && pnpm check:test",
    "check:src": "tsc --noEmit --incremental false --composite false",
    "check:test": "tsc -p tsconfig.test.json",
    "clean": "rimraf dist dist-test dist-web tsconfig.test.tsbuildinfo",
    "dev": "vite",
    "test": "vitest run"
  },
  "dependencies": {
    "@alliance/contract": "workspace:*",
    "@alliance/data": "workspace:*",
    "@alliance/compat-upstream": "workspace:*",
    "arknights-assets-catalog": "workspace:*",
    "arknights-mission-core": "workspace:*",
    "arknights-mission-renderer": "workspace:*"
  },
  "devDependencies": {
    "@alliance/shared": "workspace:*",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
