{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"],
    "customConditions": ["source"],
    "rootDir": ".",
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true
  },
  "include": ["**/*.test.ts", "**/*.spec.ts"],
  "exclude": [
    "dist",
    "dist-test",
    "dist-web",
    "node_modules",
    "**/vitest.config.ts"
  ]
}
