{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "types": ["node"],
    "customConditions": ["source"],
    "outDir": "dist-test",
    "rootDir": ".",
    "tsBuildInfoFile": "dist-test/.tsbuildinfo"
  },
  "include": ["data/**/*.ts", "server/**/*.test.ts", "client/**/*.test.ts"],
  "exclude": ["dist", "dist-test", "dist-web", "node_modules", "**/vitest.config.ts"]
}
