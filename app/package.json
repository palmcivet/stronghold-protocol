{
  "name": "stronghold-app",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#compiler/*.js": {
      "source": "./data/compiler/*.ts",
      "default": "./dist/data/compiler/*.js"
    },
    "#runtime/*.js": {
      "source": "./data/runtime/*.ts",
      "default": "./dist/data/runtime/*.js"
    },
    "#schema/*.js": {
      "source": "./data/schema/*.ts",
      "default": "./dist/data/schema/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "build:client": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "compile:packet": "node dist/data/compiler/scripts/packet.js",
    "compile:assets": "node dist/data/compiler/scripts/assets.js",
    "compile:emotes": "node dist/data/compiler/scripts/emotes.js",
    "crop:board": "node dist/data/compiler/scripts/board-atlas.js"
  },
  "dependencies": {
    "arknights-assets-catalog": "workspace:*",
    "arknights-mission-core": "workspace:*",
    "arknights-mission-renderer": "workspace:*",
    "effect": "catalog:",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
