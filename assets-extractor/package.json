{
  "name": "arknights-assets-extractor",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#catalog/*.js": {
      "source": "./catalog/*.ts",
      "default": "./dist/catalog/*.js"
    },
    "#download/*.js": {
      "source": "./download/*.ts",
      "default": "./dist/download/*.js"
    },
    "#font/*.js": {
      "source": "./font/*.ts",
      "default": "./dist/font/*.js"
    },
    "#port/*.js": {
      "source": "./port/*.ts",
      "default": "./dist/port/*.js"
    },
    "#script/*.js": {
      "source": "./script/*.ts",
      "default": "./dist/script/*.js"
    },
    "#source/*.js": {
      "source": "./source/*.ts",
      "default": "./dist/source/*.js"
    },
    "#spine/*.js": {
      "source": "./spine/*.ts",
      "default": "./dist/spine/*.js"
    },
    "#package-root.js": {
      "source": "./package-root.ts",
      "default": "./dist/package-root.js"
    },
    "#workspace.js": {
      "source": "./workspace.ts",
      "default": "./dist/workspace.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "pnpm check:src && pnpm check:test",
    "check:src": "tsc --noEmit --incremental false --composite false",
    "check:test": "tsc -p tsconfig.test.json",
    "clean": "rimraf dist dist-test tsconfig.test.tsbuildinfo",
    "extract": "node dist/script/extract.js",
    "extract:local": "python3 source/local-client/python/extract.py",
    "format": "biome check --write",
    "lint": "biome lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@pixi-spine/runtime-3.8": "^4.0.6",
    "arknights-assets-catalog": "workspace:*"
  },
  "devDependencies": {
    "@alliance/shared": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
