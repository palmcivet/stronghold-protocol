{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "outDir": null,
    "tsBuildInfoFile": null
  },
  "include": ["test/**/*.test.ts", "test/**/*.spec.ts"],
  "exclude": ["dist", "dist-test", "node_modules", "**/vitest.config.ts"]
}
