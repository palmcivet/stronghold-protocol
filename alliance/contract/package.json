{
  "name": "@alliance/contract",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#contract/*.js": {
      "@wsde/source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    "./*.js": {
      "@wsde/source": "./src/*.ts",
      "types": "./src/*.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "pnpm check:src && pnpm check:test",
    "check:src": "tsc --noEmit --incremental false --composite false",
    "check:test": "tsc -p tsconfig.test.json",
    "clean": "rimraf dist dist-test tsconfig.test.tsbuildinfo",
    "format": "biome check --write",
    "lint": "biome lint",
    "test": "vitest run"
  },
  "devDependencies": {
    "@wsde/shared": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
