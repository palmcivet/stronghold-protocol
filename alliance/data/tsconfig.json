{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "types": ["node"],
    "customConditions": ["@wsde/source"],
    "outDir": "dist",
    "rootDir": ".",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["**/*.ts"],
  "exclude": [
    "dist",
    "dist-test",
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts",
    "vitest.config.ts"
  ]
}
