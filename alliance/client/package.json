{
  "name": "@alliance/client",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#entry/*": "./entry/*",
    "#guide/*": "./guide/*",
    "#infra/*": "./infra/*",
    "#loadout/*": "./loadout/*",
    "#match/*": "./match/*",
    "#part/*": "./part/*",
    "#profile/*": "./profile/*",
    "#room/*": "./room/*",
    "#shell/*": "./shell/*",
    "#test/*": "./test/*",
    "#ui/*": "./ui/*"
  },
  "scripts": {
    "build": "tsc -b",
    "build:web": "pnpm --filter \"@alliance/client^...\" build && vite build",
    "check": "pnpm check:src && pnpm check:test",
    "check:src": "tsc --noEmit --incremental false --composite false",
    "check:test": "tsc -p tsconfig.test.json",
    "clean": "rimraf dist dist-test dist-web tsconfig.test.tsbuildinfo",
    "dev": "vite",
    "format": "biome check --write",
    "lint": "biome check . && stylelint \"**/*.css\" --ignore-pattern \"dist*/**\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@alliance/compat-upstream": "workspace:*",
    "@alliance/contract": "workspace:*",
    "@alliance/data": "workspace:*",
    "@tanstack/react-router": "^1.170.42",
    "arknights-assets-catalog": "workspace:*",
    "arknights-mission-core": "workspace:*",
    "arknights-mission-renderer": "workspace:*",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "valibot": "^1.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@swc/core": "^1.16.18",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wsde/shared": "workspace:*",
    "browserslist": "^4.29.3",
    "dependency-cruiser": "^18.6.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "lightningcss": "^1.33.0",
    "rimraf": "catalog:",
    "stylelint": "^17.16.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "browserslist": [
    "since 2021",
    "not dead"
  ]
}
