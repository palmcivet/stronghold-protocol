{
  "name": "@alliance/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens, base styles and React Aria components of the alliance client; the public UI API for mods. Component docs live beside the components (MDX) and build with `docs:build`.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./theme/index.ts"
  ],
  "imports": {
    "#ui/*": "./src/*"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./stylelint-dp-units": "./stylelint-dp-units.mjs"
  },
  "scripts": {
    "build": "vocs build",
    "check": "pnpm check:src && pnpm check:test",
    "check:src": "tsc --noEmit --incremental false --composite false",
    "check:test": "tsc -p tsconfig.test.json",
    "clean": "rimraf tsconfig.test.tsbuildinfo dist-docs",
    "dev": "vocs dev",
    "format": "biome check --write",
    "lint": "biome check . && stylelint \"**/*.css\" --ignore-pattern \"dist*/**\"",
    "preview": "vocs preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react-aria-components": "^1.22.1"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource-variable/saira": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wsde/shared": "workspace:*",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "catalog:",
    "stylelint": "^17.16.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vocs": "^2.10.3",
    "waku": "1.0.0-rc.3"
  }
}
