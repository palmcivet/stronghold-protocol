{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "outDir": null,
    "tsBuildInfoFile": null
  },
  "include": ["**/*.test.ts", "**/*.spec.ts", "**/*.test.tsx", "**/*.spec.tsx"],
  "exclude": [
    "dist",
    "dist-test",
    "dist-web",
    "node_modules",
    "**/vitest.config.ts"
  ]
}
