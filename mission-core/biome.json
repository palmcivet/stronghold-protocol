{
  "extends": "//",
  "plugins": [
    {
      "path": "./lint/determinism.grit",
      "includes": [
        "**/*.ts",
        "!**/*.test.ts",
        "!**/*.spec.ts",
        "!**/test/**",
        "!**/*.d.ts",
        "!**/dist/**"
      ]
    },
    {
      "path": "./lint/boundary.grit",
      "includes": [
        "**/*.ts",
        "!**/*.test.ts",
        "!**/*.spec.ts",
        "!**/test/**",
        "!**/*.d.ts",
        "!**/dist/**"
      ]
    }
  ],
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@wsde/shared": "A library stays independent of the workspace tooling; only vitest.config.ts may use it."
            },
            "patterns": [
              {
                "group": ["@wsde/shared/**"],
                "message": "A library stays independent of the workspace tooling; only vitest.config.ts may use it."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["vitest.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
