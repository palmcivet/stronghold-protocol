{
  "name": "arknights-mission-core",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#contract/*.js": {
      "source": "./contract/*.ts",
      "default": "./dist/contract/*.js"
    },
    "#port/*.js": {
      "source": "./port/*.ts",
      "default": "./dist/port/*.js"
    },
    "#kernel/*.js": {
      "source": "./kernel/*.ts",
      "default": "./dist/kernel/*.js"
    },
    "#battle/*.js": {
      "source": "./battle/*.ts",
      "default": "./dist/battle/*.js"
    },
    "#unit/*.js": {
      "source": "./unit/*.ts",
      "default": "./dist/unit/*.js"
    },
    "#combat/*.js": {
      "source": "./combat/*.ts",
      "default": "./dist/combat/*.js"
    },
    "#ability/*.js": {
      "source": "./ability/*.ts",
      "default": "./dist/ability/*.js"
    },
    "#field/*.js": {
      "source": "./field/*.ts",
      "default": "./dist/field/*.js"
    },
    "#economy/*.js": {
      "source": "./economy/*.ts",
      "default": "./dist/economy/*.js"
    },
    "#test/*.js": "./test/*.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "^4.10.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
