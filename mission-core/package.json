{
  "name": "arknights-mission-core",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@wsde/source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#contract/*.js": {
      "@wsde/source": "./contract/*.ts",
      "default": "./dist/contract/*.js"
    },
    "#port/*.js": {
      "@wsde/source": "./port/*.ts",
      "default": "./dist/port/*.js"
    },
    "#kernel/*.js": {
      "@wsde/source": "./kernel/*.ts",
      "default": "./dist/kernel/*.js"
    },
    "#battle/*.js": {
      "@wsde/source": "./battle/*.ts",
      "default": "./dist/battle/*.js"
    },
    "#unit/*.js": {
      "@wsde/source": "./unit/*.ts",
      "default": "./dist/unit/*.js"
    },
    "#combat/*.js": {
      "@wsde/source": "./combat/*.ts",
      "default": "./dist/combat/*.js"
    },
    "#ability/*.js": {
      "@wsde/source": "./ability/*.ts",
      "default": "./dist/ability/*.js"
    },
    "#field/*.js": {
      "@wsde/source": "./field/*.ts",
      "default": "./dist/field/*.js"
    },
    "#economy/*.js": {
      "@wsde/source": "./economy/*.ts",
      "default": "./dist/economy/*.js"
    },
    "#ledger/*.js": {
      "@wsde/source": "./ledger/*.ts",
      "default": "./dist/ledger/*.js"
    },
    "#test/*.js": "./test/*.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "pnpm check:src && pnpm check:test",
    "check:src": "tsc --noEmit --incremental false --composite false",
    "check:test": "tsc -p tsconfig.test.json",
    "clean": "rimraf dist dist-test tsconfig.test.tsbuildinfo",
    "format": "biome check --write",
    "lint": "biome lint",
    "perf": "vitest bench --run --reporter=verbose",
    "test": "vitest run"
  },
  "devDependencies": {
    "@wsde/shared": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "^4.10.2",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
