{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "outDir": null,
    "tsBuildInfoFile": null
  },
  "include": ["test", "**/*.test.ts", "**/*.spec.ts", "**/*.bench.ts"],
  "exclude": ["dist", "dist-test", "node_modules"]
}
