{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "types": ["node"],
    "rootDir": ".",
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "customConditions": ["source"]
  },
  "include": ["test", "**/*.test.ts", "**/*.spec.ts", "**/*.bench.ts"],
  "exclude": ["dist", "dist-test", "node_modules"]
}
