# normalise line endings in the repository
* text=auto
*.sh  text eol=lf
*.mjs text eol=lf
*.js  text eol=lf

# text the tests read and match line by line
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# binary assets
*.png binary
*.jpg binary
*.webp binary
*.skel binary
*.woff2 binary
*.otf binary
*.ttf binary
*.mp3 binary
*.ogg binary
