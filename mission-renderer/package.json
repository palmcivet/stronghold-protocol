{
  "name": "arknights-mission-renderer",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#contract/*.js": {
      "source": "./contract/*.ts",
      "default": "./dist/contract/*.js"
    },
    "#stage/*.js": {
      "source": "./stage/*.ts",
      "default": "./dist/stage/*.js"
    },
    "#port/*.js": {
      "source": "./port/*.ts",
      "default": "./dist/port/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "arknights-assets-catalog": "workspace:*",
    "arknights-mission-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@types/three": "^0.186.0"
  },
  "peerDependencies": {
    "three": "^0.186.1"
  }
}
