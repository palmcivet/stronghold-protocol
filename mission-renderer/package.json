{
  "name": "arknights-mission-renderer",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@wsde/source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#contract/*.js": {
      "@wsde/source": "./contract/*.ts",
      "default": "./dist/contract/*.js"
    },
    "#port/*.js": {
      "@wsde/source": "./port/*.ts",
      "default": "./dist/port/*.js"
    },
    "#runtime/*.js": {
      "@wsde/source": "./runtime/*.ts",
      "default": "./dist/runtime/*.js"
    },
    "#ground/*.js": {
      "@wsde/source": "./ground/*.ts",
      "default": "./dist/ground/*.js"
    },
    "#actor/*.js": {
      "@wsde/source": "./actor/*.ts",
      "default": "./dist/actor/*.js"
    },
    "#pointer/*.js": {
      "@wsde/source": "./pointer/*.ts",
      "default": "./dist/pointer/*.js"
    },
    "#audio/*.js": {
      "@wsde/source": "./audio/*.ts",
      "default": "./dist/audio/*.js"
    },
    "#effect/*.js": {
      "@wsde/source": "./effect/*.ts",
      "default": "./dist/effect/*.js"
    },
    "#test/*.js": "./test/*.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "pnpm check:src && pnpm check:test",
    "check:src": "tsc --noEmit --incremental false --composite false",
    "check:test": "tsc -p tsconfig.test.json",
    "clean": "rimraf dist dist-test tsconfig.test.tsbuildinfo",
    "format": "biome check --write",
    "lint": "biome lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@pixi-spine/base": "^4.0.6",
    "@pixi-spine/runtime-3.8": "^4.0.6",
    "@pixi/core": "7.4.3",
    "@pixi/display": "7.4.3",
    "@pixi/graphics": "7.4.3",
    "@pixi/mesh": "7.4.3",
    "@pixi/mesh-extras": "7.4.3",
    "@pixi/sprite": "7.4.3",
    "arknights-assets-catalog": "workspace:*",
    "arknights-mission-core": "workspace:*"
  },
  "devDependencies": {
    "@wsde/shared": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@types/three": "^0.186.0",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "three": "^0.186.1"
  }
}
