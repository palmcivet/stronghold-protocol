{
  "name": "arknights-assets-catalog",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#address/*.js": {
      "source": "./address/*.ts",
      "default": "./dist/address/*.js"
    },
    "#cache/*.js": {
      "source": "./cache/*.ts",
      "default": "./dist/cache/*.js"
    },
    "#key/*.js": {
      "source": "./key/*.ts",
      "default": "./dist/key/*.js"
    },
    "#resolver/*.js": {
      "source": "./resolver/*.ts",
      "default": "./dist/resolver/*.js"
    },
    "#schema/*.js": {
      "source": "./schema/*.ts",
      "default": "./dist/schema/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "pnpm check:src && pnpm check:test",
    "check:src": "tsc --noEmit --incremental false --composite false",
    "check:test": "tsc -p tsconfig.test.json",
    "clean": "rimraf dist dist-test tsconfig.test.tsbuildinfo",
    "format": "biome check --write",
    "lint": "biome lint",
    "test": "vitest run"
  },
  "devDependencies": {
    "@alliance/shared": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
