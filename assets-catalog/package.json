{
  "name": "arknights-assets-catalog",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#schema/*.js": {
      "source": "./schema/*.ts",
      "default": "./dist/schema/*.js"
    },
    "#runtime/*.js": {
      "source": "./runtime/*.ts",
      "default": "./dist/runtime/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
