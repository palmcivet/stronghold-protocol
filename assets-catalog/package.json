{
  "name": "arknights-assets-catalog",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#address/*.js": {
      "source": "./address/*.ts",
      "default": "./dist/address/*.js"
    },
    "#cache/*.js": {
      "source": "./cache/*.ts",
      "default": "./dist/cache/*.js"
    },
    "#key/*.js": {
      "source": "./key/*.ts",
      "default": "./dist/key/*.js"
    },
    "#resolver/*.js": {
      "source": "./resolver/*.ts",
      "default": "./dist/resolver/*.js"
    },
    "#schema/*.js": {
      "source": "./schema/*.ts",
      "default": "./dist/schema/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
